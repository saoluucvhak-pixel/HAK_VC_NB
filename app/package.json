{
  "name": "hak-vc",
  "productName": "HAK VC",
  "version": "1.2.5",
  "private": true,
  "description": "HAK VC — DGVC (đơn giá vận chuyển dăm) + VC Cost (quản lý · đối chiếu chi phí vận chuyển) trong một ứng dụng",
  "main": "main/electron/suite.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "verify:seed": "node tools/verify-seed.js",
    "start": "electron .",
    "dev": "node tools/dev-server.js",
    "test:electron": "xvfb-run -a node tests/electron.smoke.js",
    "compare": "node tools/compare-excel.js",
    "build:catalog": "node tools/build-catalog.js",
    "dist": "electron-builder --win dir --x64 && makensis -V2 installer/dgvc.nsi",
    "dist:win": "electron-builder --win nsis --x64",
    "test:vccost": "node --test modules/vccost/tests/*.test.js",
    "test:all": "npm test && npm run test:vccost",
    "validate:vccost": "node modules/vccost/scripts/validate-sample.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "exceljs": "^4.4.0",
    "better-sqlite3": "^12.2.0",
    "decimal.js": "^10.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "author": "HAK Group",
  "build": {
    "appId": "vn.hakgroup.hakvc",
    "productName": "HAK VC",
    "executableName": "DGVC",
    "copyright": "HAK Group",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "modules/**",
      "!modules/**/tests/**",
      "!modules/**/docs/**",
      "renderer/**",
      "shared/**",
      "resources/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "!**/*.test.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HAK VC",
      "uninstallDisplayName": "HAK VC (DGVC + VC Cost)",
      "artifactName": "HAK-VC-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "vi_VN"
      ],
      "language": "1066"
    },
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
